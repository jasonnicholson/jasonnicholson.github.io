{
  "columns": ["Iteration", "Method", "Step Size", "x", "y"],
  "methodOptions": ["secant", "muller"],
  "defaultMethodByPointCount": {
    "twoPoints": "secant",
    "threePoints": "muller"
  },
  "defaultStepSize": 1.0,
  "stepSizeMin": 0.0,
  "targetYDefault": 1.0,
  "displaySignificantDigits": 8,
  "tolerance": {
    "denominator": 1e-12,
    "duplicateX": 1e-12
  },
  "dropdownPolicy": "disable-invalid-choices",
  "stepSizeScope": "per-row",
  "numericDisplayPolicy": "fixed-significant-digits",
  "blockedReason": {
    "insufficient_points": "insufficient_points",
    "repeated_x": "repeated_x",
    "zero_denominator": "zero_denominator",
    "complex_muller_step": "complex_muller_step",
    "invalid_number": "invalid_number"
  },
  "event": {
    "trigger": "y-or-step-size-or-method-edit-complete",
    "triggerFields": ["y", "Step Size", "Method"],
    "triggerSourceRow": "edited-row",
    "triggerTargetRow": "edited-row-plus-one",
    "action": "compute-next-x"
  }
}
